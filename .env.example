# Copy this file to server/.env and fill in real values.
# Never commit your real .env file.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fittogether?retryWrites=true&w=majority

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Express server port (the Vite client proxies /api and /socket.io here).
PORT=3000

# Allowed CORS origin (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173
